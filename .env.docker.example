# Docker 部署用的环境变量示例
#
# 用法:
#   cp .env.docker.example .env.docker
#   编辑 .env.docker,按需填写
#
# 这个文件会被 docker-compose.yml 通过 env_file 加载,传递给 backend 容器。
# 前端不需要环境变量(构建期已经嵌入静态文件)。

# ===== 端口映射 =====
# 前端容器 80 端口映射到宿主机的哪个端口
FRONTEND_PORT=8080

# ===== 构建目标 =====
# runtime(默认,不含 ASR) / asr(含本地 ASR,需要 GPU)
BACKEND_TARGET=runtime

# ===== 时区 =====
TZ=Asia/Shanghai

# ===== B站(可选) =====
# 登录后的浏览器 Cookie。留空也能跑,但搜索/字幕更易触发风控。
# 启动后也可以在 Web 页面右上角「设置」中配置,会持久化到 SQLite。
BILIBILI_SESSDATA=
BILIBILI_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36

# ===== LLM(必填,推荐通义千问) =====
# 通义千问示例:https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen3-235b-a22b-instruct
LLM_TIMEOUT_SEC=300
LLM_JSON_MODE=true

# ===== 本地 ASR(可选,只有 BACKEND_TARGET=asr 时才生效) =====
# 模型路径(容器内或挂载进来的路径)。留空则不启用本地 ASR。
QWEN_ASR_MODEL_PATH=
QWEN_ASR_DEVICE=cuda:0

# ===== RAGFlow 语料(可选) =====
RAGFLOW_CORPUS_ENABLED=true
RAGFLOW_CORPUS_DIR=/app/data/corpus
RAGFLOW_SYNC_ENABLED=false
RAGFLOW_BASE_URL=
RAGFLOW_WEB_URL=
RAGFLOW_API_KEY=
RAGFLOW_EMBEDDING_MODEL=
RAGFLOW_CHUNK_METHOD=naive
RAGFLOW_DATASET_LANGUAGE=Chinese

# ===== Embedding =====
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_DIM=1024

# ===== 重排序(默认关闭) =====
RERANK_ENABLED=false
RERANK_MODEL=BAAI/bge-reranker-base
RERANK_MODEL_PATH=
RERANK_TOP_K=20

# ===== 后台任务调度器 =====
SCHEDULER_ENABLED=true
SCHEDULER_SUBTITLE_INTERVAL_SEC=120
SCHEDULER_SUMMARY_INTERVAL_SEC=120
SCHEDULER_BACKFILL_INTERVAL_SEC=900
SCHEDULER_BATCH_SIZE=10

# ===== 日志 =====
LOG_LEVEL=INFO
