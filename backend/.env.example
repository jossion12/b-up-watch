# ===== B站 =====
# 登录后的浏览器 Cookie（SESSDATA 等）；留空也能跑，但搜索/字幕更易触发风控。
# 提示：SESSDATA 现在也可在 Web 页面「设置」中配置，会持久化到数据库并即时生效。
BILIBILI_SESSDATA=
BILIBILI_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36

# ===== LLM（OpenAI 兼容接口） =====
# 通义千问示例：https://dashscope.aliyuncs.com/compatible-mode/v1
# Ollama 本地示例：http://127.0.0.1:11434/v1  （注意要带 /v1）
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen3-235b-a22b-instruct
# 本地模型首次加载可能需要几分钟，单位秒
LLM_TIMEOUT_SEC=300
# 是否要求模型返回 JSON（response_format=json_object）。Ollama/本地模型若返回空内容，可改为 false
LLM_JSON_MODE=true

# ===== ASR（本地 Qwen3-ASR，用于字幕兜底转写） =====
# 模型路径：例如 D:/model/modelscope/Qwen3-ASR-1.7B
# 留空时 subtitle_fetch 在 B站无字幕时返回 SUBTITLE_UNAVAILABLE，不会自动 fallback
QWEN_ASR_MODEL_PATH=
QWEN_ASR_DEVICE=cuda:0

# yt-dlp 的 cookie 文件（可选，用于登录态访问受限视频）
YT_DLP_COOKIES_FILE=



# ===== UP 复盘 RAG =====
# 复盘 Markdown 文件根目录（相对 backend 根目录），子目录名需与 Uploader.name 一致
REVIEW_BASE_DIR=./data
# 字幕获取成功后是否自动导入 RAG（true 会调用 LLM 提取观点卡片并写入向量库；false 只归档 Markdown）
# 当前已切换为生成 RAGFlow 语料，原 Milvus 导入路径默认关闭。
RAG_AUTO_INGEST_ENABLED=false
# 是否自动生成 RAGFlow 语料文件（Markdown，无 LLM）
RAGFLOW_CORPUS_ENABLED=true
# RAGFlow 语料输出目录
RAGFLOW_CORPUS_DIR=./data/corpus
# 是否将语料自动同步到 RagFlow 知识库（需配置下方 RAGFLOW_BASE_URL/API_KEY）
RAGFLOW_SYNC_ENABLED=false
# RagFlow 服务地址，例如 http://127.0.0.1:9380
RAGFLOW_BASE_URL=
# RagFlow Web UI 地址（用于生成聊天分享链接）。留空则默认与 RAGFLOW_BASE_URL 一致。
# Docker 部署时 Web UI 通常在 80 端口，API 在 9380 端口，此时应配置为 http://localhost
RAGFLOW_WEB_URL=
# RagFlow API Key
RAGFLOW_API_KEY=
# 创建知识库时使用的 Embedding 模型，例如 BAAI/bge-large-zh-v1.5@BAAI
RAGFLOW_EMBEDDING_MODEL=
# 分块方法，默认 naive
RAGFLOW_CHUNK_METHOD=naive
# 创建知识库时的语言，默认 Chinese
RAGFLOW_DATASET_LANGUAGE=Chinese
# 文档解析轮询超时（秒）
RAGFLOW_PARSE_TIMEOUT_SEC=600
# 解析轮询间隔（秒）
RAGFLOW_PARSE_POLL_INTERVAL_SEC=3
# Embedding 后端：sentence_transformers 或 ollama
EMBEDDING_PROVIDER=sentence_transformers
# Embedding 模型，sentence_transformers 时填写 HuggingFace 模型名；ollama 时填写 Ollama 模型名
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
# Embedding 维度，需与模型一致；bge-large-zh-v1.5 为 1024，Ollama qwen3-embedding 为 4096
EMBEDDING_DIM=1024
OLLAMA_BASE_URL=http://localhost:11434

# 重排序（交叉编码器），默认关闭
RERANK_ENABLED=false
# RERANK_MODEL 支持 HuggingFace 模型名或本地路径；若同时填写 RERANK_MODEL_PATH，优先使用 RERANK_MODEL_PATH
RERANK_MODEL=BAAI/bge-reranker-base
RERANK_MODEL_PATH=
RERANK_TOP_K=20

# ===== Milvus 向量库 =====
# 若设置以 .db 结尾的本地路径，则使用 Milvus Lite 本地模式（无需启动 Docker）。
# 若留空，则连接 milvus_host:milvus_port 的服务器模式。
MILVUS_URI=./data/milvus/taoge.db
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=taoge_review_chunks

# ===== 服务 =====
DATABASE_URL=sqlite:///./data/upwatch.db
LOG_LEVEL=INFO

# ===== 后台任务调度器 =====
# 总开关（同时依赖 WORKER_ENABLED=true）
SCHEDULER_ENABLED=true
# 字幕/总结任务扫描间隔（秒）
SCHEDULER_SUBTITLE_INTERVAL_SEC=120
SCHEDULER_SUMMARY_INTERVAL_SEC=120
# 回溯更早视频扫描间隔（秒），仅在当前没有未字幕/未总结视频时才执行
SCHEDULER_BACKFILL_INTERVAL_SEC=900
# 每次扫描最多生成多少个任务
SCHEDULER_BATCH_SIZE=10
# 回溯时在当前最老视频基础上再往前推多少天
BACKFILL_EXTRA_DAYS=30
# 回溯时最大翻页数（B站空间接口每页 30 条）
BACKFILL_MAX_PAGES=10